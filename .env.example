# Either provider works — set ONE of these. Anthropic wins if both are set.
# Copy this file to .env and paste your key there — .env is gitignored.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides.
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o-mini

# Optional: any OpenAI-compatible endpoint that supports tool calling.
# Sarvam:  OPENAI_BASE_URL=https://api.sarvam.ai/v1  with OPENAI_MODEL=sarvam-105b
# Leave blank for api.openai.com.
OPENAI_BASE_URL=

# Optional: force a provider ("anthropic" or "openai"). Default "auto".
LLM_PROVIDER=auto

PORT=8000
